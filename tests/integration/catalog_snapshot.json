 "schedule_maintenance": {
  "description": "Schedule a maintenance window (cameras go offline during it). Windows longer than 120 minutes or\n        with more than 10 cameras need approval by a second person.",
  "input": {
   "additionalProperties": false,
   "properties": {
    "approval_id": {
     "anyOf": [
      {
       "description": "Approval id returned by an approval_required result.",
       "pattern": "^apr_[a-z0-9]{12}$",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Approval Id"
    },
    "camera_ids": {
     "description": "Cameras affected.",
     "items": {
      "description": "Camera id, e.g. cam_aur00101.",
      "pattern": "^cam_[a-z0-9]{6,10}$",
      "type": "string"
     },
     "maxItems": 50,
     "minItems": 1,
     "title": "Camera Ids",
     "type": "array",
     "uniqueItems": true
    },
    "client_id": {
     "description": "Client id, e.g. cli_aur001.",
     "pattern": "^cli_[a-z0-9]{6}$",
     "title": "Client Id",
     "type": "string"
    },
    "duration_minutes": {
     "description": "Window length in minutes (15-480).",
     "maximum": 480,
     "minimum": 15,
     "title": "Duration Minutes",
     "type": "integer"
    },
    "idempotency_key": {
     "description": "Unique per intended action; reuse the same key when retrying the same action.",
     "pattern": "^[A-Za-z0-9_-]{16,64}$",
     "title": "Idempotency Key",
     "type": "string"
    },
    "reason": {
     "description": "Why the maintenance is needed.",
     "maxLength": 200,
     "minLength": 5,
     "title": "Reason",
     "type": "string"
    },
    "starts_at": {
     "format": "date-time",
     "title": "Starts At",
     "type": "string"
