   "additionalProperties": false,
   "properties": {
    "client_id": {
     "description": "Client id, e.g. cli_aur001.",
     "pattern": "^cli_[a-z0-9]{6}$",
     "title": "Client Id",
     "type": "string"
    },
    "days": {
     "default": 30,
     "description": "Number of days to look ahead.",
     "maximum": 90,
     "minimum": 1,
     "title": "Days",
     "type": "integer"
    },
    "from_date": {
     "anyOf": [
      {
       "format": "date",
       "type": "string"
      },
      {
       "type": "null"
