 },
 "send_notification": {
  "description": "Send a templated notification about a ticket or maintenance window to the client's opted-in contacts.\n        Message text is generated by the server; there is no free-text field. all_contacts or sms needs approval.",
  "input": {
   "additionalProperties": false,
   "properties": {
    "approval_id": {
     "anyOf": [
      {
       "description": "Approval id returned by an approval_required result.",
       "pattern": "^apr_[a-z0-9]{12}$",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Approval Id"
    },
    "audience": {
     "enum": [
      "primary_contact",
      "all_contacts"
     ],
     "title": "Audience",
     "type": "string"
    },
    "channel": {
     "enum": [
      "email",
      "sms"
     ],
     "title": "Channel",
     "type": "string"
    },
    "client_id": {
     "description": "Client id, e.g. cli_aur001.",
     "pattern": "^cli_[a-z0-9]{6}$",
     "title": "Client Id",
     "type": "string"
    },
    "idempotency_key": {
     "description": "Unique per intended action; reuse the same key when retrying the same action.",
     "pattern": "^[A-Za-z0-9_-]{16,64}$",
     "title": "Idempotency Key",
     "type": "string"
    },
    "reference_id": {
     "description": "Ticket id (ticket_update, incident_update) or maintenance id (maintenance_notice).",
     "pattern": "^(tkt|mnt)_[a-z0-9]{6,12}$",
     "title": "Reference Id",
     "type": "string"
    },
    "template": {
     "enum": [
      "maintenance_notice",
      "incident_update",
      "ticket_update"
     ],
     "title": "Template",
     "type": "string"
    }
   },
   "required": [
    "client_id",
    "template",
    "reference_id",
    "audience",
    "channel",
    "idempotency_key"
   ],
   "title": "send_notificationArguments",
   "type": "object"
  },
  "output": {
   "$defs": {
    "ApprovalInfo": {
     "properties": {
      "approval_id": {
       "title": "Approval Id",
       "type": "string"
      },
      "expires_at": {
       "format": "date-time",
       "title": "Expires At",
       "type": "string"
      },
      "policy_id": {
       "title": "Policy Id",
       "type": "string"
      },
      "reason": {
       "title": "Reason",
       "type": "string"
      }
     },
     "required": [
      "approval_id",
      "expires_at",
      "reason",
      "policy_id"
     ],
     "title": "ApprovalInfo",
     "type": "object"
    }
   },
   "properties": {
    "approval": {
     "anyOf": [
      {
       "$ref": "#/$defs/ApprovalInfo"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "delivery_status": {
     "anyOf": [
      {
       "enum": [
        "queued",
        "sent"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Delivery Status"
    },
    "notification_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Notification Id"
    },
    "recipients_count": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Recipients Count"
    },
    "replayed": {
     "default": false,
     "title": "Replayed",
     "type": "boolean"
    },
    "status": {
     "enum": [
      "completed",
      "approval_required"
     ],
     "title": "Status",
     "type": "string"
    }
   },
   "required": [
    "status"
   ],
   "title": "NotificationSent",
   "type": "object"
  }
 }
