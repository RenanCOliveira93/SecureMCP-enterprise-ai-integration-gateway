{
 "create_support_ticket": {
  "description": "Open a support ticket for a client. Critical priority pages on-call staff and needs approval:\n        the result is then status \"approval_required\" with an approval_id to retry with after approval.",
  "input": {
   "additionalProperties": false,
   "properties": {
    "approval_id": {
     "anyOf": [
      {
       "description": "Approval id returned by an approval_required result.",
       "pattern": "^apr_[a-z0-9]{12}$",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Approval Id"
    },
    "camera_id": {
     "anyOf": [
      {
       "description": "Camera id, e.g. cam_aur00101.",
       "pattern": "^cam_[a-z0-9]{6,10}$",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Camera Id"
    },
    "category": {
     "enum": [
      "camera_offline",
      "image_quality",
      "analytics",
      "billing",
      "other"
     ],
     "title": "Category",
     "type": "string"
    },
    "client_id": {
     "description": "Client id, e.g. cli_aur001.",
     "pattern": "^cli_[a-z0-9]{6}$",
     "title": "Client Id",
     "type": "string"
    },
    "description": {
     "description": "What happened, observed impact.",
     "maxLength": 2000,
     "minLength": 10,
     "title": "Description",
     "type": "string"
    },
    "idempotency_key": {
     "description": "Unique per intended action; reuse the same key when retrying the same action.",
     "pattern": "^[A-Za-z0-9_-]{16,64}$",
     "title": "Idempotency Key",
     "type": "string"
    },
    "priority": {
     "enum": [
      "low",
      "medium",
      "high",
      "critical"
     ],
     "title": "Priority",
     "type": "string"
    },
    "subject": {
     "description": "Short ticket title.",
     "maxLength": 120,
     "minLength": 5,
     "title": "Subject",
     "type": "string"
    }
   },
   "required": [
    "client_id",
    "subject",
    "description",
    "priority",
    "category",
    "idempotency_key"
   ],
   "title": "create_support_ticketArguments",
   "type": "object"
  },
  "output": {
   "$defs": {
    "ApprovalInfo": {
     "properties": {
      "approval_id": {
       "title": "Approval Id",
       "type": "string"
      },
      "expires_at": {
       "format": "date-time",
       "title": "Expires At",
       "type": "string"
      },
      "policy_id": {
       "title": "Policy Id",
       "type": "string"
      },
      "reason": {
       "title": "Reason",
       "type": "string"
      }
     },
     "required": [
      "approval_id",
      "expires_at",
      "reason",
      "policy_id"
     ],
     "title": "ApprovalInfo",
     "type": "object"
    }
   },
   "properties": {
    "approval": {
     "anyOf": [
      {
       "$ref": "#/$defs/ApprovalInfo"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "client_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Client Id"
    },
    "priority": {
     "anyOf": [
      {
       "enum": [
        "low",
        "medium",
        "high",
        "critical"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Priority"
    },
    "replayed": {
     "default": false,
     "title": "Replayed",
     "type": "boolean"
    },
    "status": {
     "enum": [
      "completed",
      "approval_required"
     ],
     "title": "Status",
     "type": "string"
    },
    "ticket_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Ticket Id"
    },
    "ticket_status": {
     "anyOf": [
      {
       "enum": [
        "open",
        "in_progress",
        "resolved",
        "closed"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Ticket Status"
    }
   },
   "required": [
    "status"
   ],
   "title": "TicketCreated",
   "type": "object"
  }
 },
 "get_client": {
  "description": "Get one client account of your tenant: profile, masked contacts and CRM account health.\n        If the CRM is unavailable the result still returns with crm.status = \"unavailable\".",
  "input": {
   "additionalProperties": false,
   "properties": {
    "client_id": {
     "description": "Client id, e.g. cli_aur001.",
     "pattern": "^cli_[a-z0-9]{6}$",
     "title": "Client Id",
     "type": "string"
    }
   },
   "required": [
    "client_id"
   ],
   "title": "get_clientArguments",
   "type": "object"
  },
  "output": {
   "$defs": {
    "Contact": {
     "properties": {
      "contact_id": {
       "title": "Contact Id",
       "type": "string"
      },
      "email_masked": {
       "title": "Email Masked",
       "type": "string"
      },
      "name": {
       "title": "Name",
       "type": "string"
      },
      "notify_opt_in": {
       "title": "Notify Opt In",
       "type": "boolean"
      },
      "phone_masked": {
       "title": "Phone Masked",
       "type": "string"
      },
      "role": {
       "title": "Role",
       "type": "string"
      }
     },
     "required": [
      "contact_id",
      "name",
      "role",
      "email_masked",
      "phone_masked",
      "notify_opt_in"
     ],
     "title": "Contact",
     "type": "object"
    },
    "CrmAccount": {
     "properties": {
      "account_manager": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Account Manager"
      },
      "health": {
       "anyOf": [
        {
         "enum": [
          "green",
          "yellow",
          "red"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Health"
      },
      "open_opportunities": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Open Opportunities"
      },
      "status": {
       "enum": [
        "ok",
        "unavailable"
       ],
       "title": "Status",
       "type": "string"
      }
     },
     "required": [
      "status"
     ],
     "title": "CrmAccount",
     "type": "object"
    }
   },
   "properties": {
    "account_tier": {
     "title": "Account Tier",
     "type": "string"
    },
    "client_id": {
     "title": "Client Id",
     "type": "string"
    },
    "contacts": {
     "items": {
      "$ref": "#/$defs/Contact"
     },
     "title": "Contacts",
     "type": "array"
    },
    "crm": {
     "$ref": "#/$defs/CrmAccount"
    },
    "name": {
     "title": "Name",
     "type": "string"
    },
    "region": {
     "title": "Region",
     "type": "string"
    },
    "segment": {
     "title": "Segment",
     "type": "string"
    },
    "status": {
     "title": "Status",
     "type": "string"
    }
   },
   "required": [
    "client_id",
    "name",
    "segment",
    "region",
    "status",
    "account_tier",
    "contacts",
    "crm"
   ],
   "title": "ClientView",
   "type": "object"
  }
 },
