      },
      "reason": {
       "title": "Reason",
       "type": "string"
      }
     },
     "required": [
      "approval_id",
      "expires_at",
      "reason",
      "policy_id"
     ],
     "title": "ApprovalInfo",
     "type": "object"
    }
   },
   "properties": {
