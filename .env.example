# Copy to .env for local runs outside Compose. Every variable is documented in docs/configuration.md.
# Secrets do NOT go here: see deploy/secrets/README.md.
SECUREMCP_ENV=dev
SECUREMCP_LOG_LEVEL=INFO
SECUREMCP_LOG_FORMAT=console
SECUREMCP_PUBLIC_URL=http://localhost:8000/mcp
SECUREMCP_DATABASE_URL=sqlite+aiosqlite:///./securemcp.db
SECUREMCP_AUTH_ISSUER=http://localhost:9000
SECUREMCP_AS_ISSUER=http://localhost:9000
SECUREMCP_AS_ALLOWED_RESOURCES=http://localhost:8000/mcp
SECUREMCP_CRM_URL=http://localhost:8081/crm
SECUREMCP_NOTIFICATIONS_URL=http://localhost:8081/notifications
SECUREMCP_HOST_MCP_URL=http://localhost:8000/mcp
SECUREMCP_AGENT_PLANNER=rule
# SECUREMCP_AGENT_PLANNER=claude   # needs ANTHROPIC_API_KEY in the environment of securemcp-host
